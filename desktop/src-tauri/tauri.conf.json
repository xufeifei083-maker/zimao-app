{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flynotes AI 控制中心",
  "version": "0.1.0",
  "identifier": "ai.flynotes.control-center",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flynotes AI 控制中心",
        "width": 1280,
        "height": 800,
        "minWidth": 1050,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:17980 ws://127.0.0.1:17980; img-src 'self' asset: http://asset.localhost http://127.0.0.1:17980 data: blob:; media-src 'self' http://127.0.0.1:17980 blob:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/agent/flynotes-local-agent.exe"],
    "icon": ["icons/icon.ico"]
  }
}
